<?xml version="1.0"?>
<package format="3">

  <name>auro_uav_slam</name>
  <version>0.1.0</version>

  <description>
    AUROUAV SLAM package providing feature tracking,
    loop closure detection, pose graph optimization,
    and localization services.
  </description>

  <maintainer email="carrywin100@yahoo.com">
    Emmanuel Musvaire
  </maintainer>

  <license>MIT</license>

  <!-- Build System -->
  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- ROS 2 Core -->
  <depend>rclcpp</depend>

  <!-- Messages -->
  <depend>std_msgs</depend>
  <depend>sensor_msgs</depend>
  <depend>nav_msgs</depend>
  <depend>geometry_msgs</depend>

  <!-- Images -->
  <depend>image_transport</depend>
  <depend>cv_bridge</depend>

  <!-- Visualization -->
  <depend>visualization_msgs</depend>

  <!-- TF -->
  <depend>tf2</depend>
  <depend>tf2_ros</depend>
  <depend>tf2_geometry_msgs</depend>

  <!-- Custom AUROUAV Messages -->
  <depend>auro_uav_msgs</depend>

  <!-- Testing -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build